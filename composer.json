{
    "name": "gusmanwidodo/auth-kit",
    "description": "A plugin-based authentication framework for Laravel, inspired by better-auth. Small core, extend everything via plugins.",
    "keywords": ["laravel", "authentication", "auth", "plugin", "better-auth", "otp", "2fa"],
    "homepage": "https://github.com/gusmanwidodo/auth-kit",
    "license": "MIT",
    "authors": [
        {
            "name": "Gusman Widodo",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^11.0 || ^12.0",
        "illuminate/support": "^11.0 || ^12.0",
        "illuminate/database": "^11.0 || ^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Gusmanwidodo\\AuthKit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gusmanwidodo\\AuthKit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gusmanwidodo\\AuthKit\\AuthKitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
